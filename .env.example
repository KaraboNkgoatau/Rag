# Copy to .env and fill in. Never commit .env.

# --- Option A: AWS Bedrock (used when BEDROCK_MODEL_ID is set) ---
BEDROCK_MODEL_ID=eu.anthropic.claude-haiku-5-5
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

